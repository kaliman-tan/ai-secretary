# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_EMAIL_CHANNEL_ID=channel_id_for_email_notifications
DISCORD_REPORT_CHANNEL_ID=channel_id_for_daily_reports
DISCORD_TODO_CHANNEL_ID=channel_id_for_todo

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5

# Gmail / Google APIs
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
GOOGLE_TOKEN_PATH=credentials/google_token.json

# Notion
NOTION_API_KEY=your_notion_api_key
NOTION_CALENDAR_DATABASE_ID=your_notion_database_id

# ローカルDB（SQLite）。省略時は <プロジェクト>/data/ai_secretary.db
# WSL2 の ext4 上に置くこと（/mnt/c 配下は不可）
# DB_PATH=/home/kaliman/ai-secretary/data/ai_secretary.db

# 旧 Supabase（scripts/migrate_supabase_to_sqlite.py 専用。移行後は不要）
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_anon_key

# Settings
TIMEZONE=Asia/Tokyo
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0
EMAIL_CHECK_INTERVAL_MINUTES=15

# Gmail 就活バッチ
GMAIL_JOB_LABEL=就活

# Anthropic クレジット監視
ANTHROPIC_CURRENT_CREDITS=5.00
ANTHROPIC_MONTHLY_USED=0.00
ANTHROPIC_DAILY_AVG=0.10
DISCORD_CREDIT_CHANNEL_ID=クレジット監視チャンネルのID

# 就活リサーチ
DISCORD_JOB_RESEARCH_CHANNEL_ID=就活リサーチ結果を投稿するチャンネルのID
